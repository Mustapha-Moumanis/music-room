# ── App ──
# NestJS runtime mode; development is the Docker dev default.
NODE_ENV=development
# Backend listening port; match the Docker published port.
BACKEND_PORT=3000
# Public backend base URL for mail links; set to your reachable backend URL.
APP_URL=http://localhost:3000
# Browser origins allowed to call the API, comma-separated. For Expo web opened from other machines, add
# http://<this-machine-lan-ip>:8081 (the native Android app sends no Origin and is unaffected).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Pino log verbosity; info is the development default.
LOG_LEVEL=info

# ── Database ──
# PostgreSQL hostname; postgres is the Docker Compose service name.
POSTGRES_HOST=postgres
# PostgreSQL listening port; 5432 is the PostgreSQL 16 default.
POSTGRES_PORT=5432
# Host port the postgres container is published on (5433 avoids clashing with a local Postgres on 5432).
# Use it with localhost when running the backend or Prisma CLI outside Docker.
POSTGRES_PUBLISH_PORT=5433
# Database role created by Docker; keep aligned with DATABASE_URL.
POSTGRES_USER=musicroom
# Database password; dev placeholder. Generate one: openssl rand -base64 48
POSTGRES_PASSWORD=change-me
# Database name created by Docker; keep aligned with DATABASE_URL.
POSTGRES_DB=musicroom
# Prisma reads this URL; derive it from POSTGRES_* and URL-encode credentials.
# Outside Docker use localhost:$POSTGRES_PUBLISH_PORT instead of postgres:5432.
# Its password uses the dev placeholder above; generate one: openssl rand -base64 48
DATABASE_URL=postgresql://musicroom:change-me@postgres:5432/musicroom?schema=public
# Optional e2e database URL used by backend npm run test:e2e from the host.
# TEST_DATABASE_URL=postgresql://musicroom:change-me@localhost:5433/musicroom_test?schema=public

# ── Auth ──
# Access JWT signing secret; generate independently: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
# Access token lifetime; 15m is the application auth policy default.
JWT_ACCESS_TTL=15m
# Rotating refresh JWT signing secret; generate independently: openssl rand -base64 48
JWT_REFRESH_SECRET=change-me-refresh-secret
# Refresh token lifetime; 30d is the application auth policy default.
JWT_REFRESH_TTL=30d
# Email verification token lifetime; 24h is the application policy default.
EMAIL_VERIFY_TTL=24h
# Password reset token lifetime; 15m is the application policy default.
PASSWORD_RESET_TTL=15m

# ── Rate limiting ──
# NestJS throttler window in milliseconds; default is one minute.
THROTTLE_TTL_MS=60000
# Requests allowed per throttler window; application default is 100.
THROTTLE_LIMIT=100
# Login/reset brute-force guard requests per window; application default is 5.
AUTH_THROTTLE_LIMIT=5

# ── Mail ──
# SMTP server for the noreply account (for example, smtp.example.com).
SMTP_HOST=smtp.example.com
# Use 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587
# Full username for the noreply mailbox.
SMTP_USER=noreply@example.com
# SMTP password or provider-issued app password. Keep the real value only in .env.
SMTP_PASSWORD=change-me
# Verified sender identity for the noreply mailbox.
MAIL_FROM="Music Room <noreply@example.com>"

# ── Google ──
# Google Cloud Console OAuth client ID (type Web); server-side idToken audience.
GOOGLE_WEB_CLIENT_ID=

# ── Music ──
# Deezer public API base URL from Deezer; proxied by the backend, no key needed.
DEEZER_API_URL=https://api.deezer.com
