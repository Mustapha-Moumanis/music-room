# ── Public Expo configuration ──
# Only EXPO_PUBLIC_* variables are bundled into the app; they are public.
# Never put secrets in EXPO_PUBLIC_* variables.

# Default backend URL; 10.0.2.2 reaches the host from the Android emulator.
# Use your host's LAN IP for a physical phone; overridable in app Settings at runtime.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Socket.IO backend URL; use the same host and port as the backend API URL.
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000
# Same Google Cloud Web client ID as backend GOOGLE_WEB_CLIENT_ID;
# @react-native-google-signin needs it to obtain an idToken.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Build configuration ──
# Non-public build variant read by app.config; development is the local default.
APP_VARIANT=development
